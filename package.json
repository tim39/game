{
  "name": "the-fifth-flame",
  "private": true,
  "version": "0.0.0",
  "description": "A classic high-fantasy JRPG for the browser, with turn-order-timeline battles and 16-bit-style pixel art.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node tools/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "validate": "tsx tools/validate.ts",
    "sim": "node tools/not-yet.mjs sim \"M3 (battle simulator)\"",
    "test:e2e": "playwright test",
    "fetch-assets": "tsx tools/fetch-assets.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tim39/game.git"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
